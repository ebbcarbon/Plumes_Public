# Virtual environments
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Our own model run outputs. Note: .dat is NOT ignored globally — exe-generated
# .dat files in the validation case folders (reference_cases/caseNN_*/ and
# upstream/Example_project/) are reference data and must be tracked.
runs/
out/
scratch/

# Rendered API reference (docs/build.py regenerates it)
docs/api/

# Warm ledger-outcome cache written by the test suite (single file, overwritten in
# place). Keyed on a digest of src/plumes2 plus the archived .dat/.prj/.csv, so any
# change to the model or the reference data discards it. Safe to delete; regenerated
# on the next run. `pytest --wipe-outcome-cache` removes it explicitly.
.plumes2_outcome_cache.json

# Study by-products. The CSVs, SVGs and READMEs under studies/ are tracked -- they are the
# record of a run -- but the PNG previews and run logs are regenerated by the script.
studies/**/*.png
studies/**/run.log

# Generated reports. Local by default: nothing under reports/ is tracked unless added by force
# (`git add -f reports/<date>_<name>`), which the operator does for the reports worth keeping
# (2026-09-09's, for instance). Tracked or not, `.publicignore` withholds the whole folder from
# the public snapshot. `plumes2 report CASE -o reports/<date>_<case>/<case>.pdf` writes here.
reports/
